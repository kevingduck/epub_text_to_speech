<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.audiobooks</string>
  <key>ProgramArguments</key>
  <array>
    <string>/PATH/TO/epub_text_to_speech/.venv/bin/uvicorn</string>
    <string>app.main:app</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8000</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/PATH/TO/epub_text_to_speech</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/PATH/TO/epub_text_to_speech/data/server.log</string>
  <key>StandardErrorPath</key>
  <string>/PATH/TO/epub_text_to_speech/data/server.log</string>
</dict>
</plist>
